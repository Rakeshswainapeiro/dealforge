# DealForge local configuration (docker-compose reads this file automatically)

# OpenAI-compatible AI backend used by all AI features (analysis, extraction, etc.)
# Works with OpenAI, Azure OpenAI, Groq, Together, LM Studio, Ollama (/v1), Atlas Xailon, etc.
# The key is read by the server only. Put it in your local .env (git-ignored),
# never in a VITE_* variable, in src/, or in Settings > AI in the browser. Before
# AI calls work, an admin must also approve the provider under Admin > AI governance.
# Check it with: npm run ai:check
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Atlas Xailon Gateway (Optional automated token management for https://api-atlas.xailon.ai)
# If using Atlas Xailon, set OPENAI_BASE_URL=https://api-atlas.xailon.ai/v1/llm and OPENAI_MODEL=atlas-supernova
# DealForge automatically refreshes 15-minute access tokens and persists rotated refresh tokens in AppSettings,
# encrypted (AES-256-GCM). The key is TOKEN_ENCRYPTION_KEY (64 hex chars or base64 of 32 bytes; generate with
# openssl rand -hex 32) or, when unset, one derived from BETTER_AUTH_SECRET. With neither set, tokens are kept in
# memory only. To rotate the key, set the new TOKEN_ENCRYPTION_KEY and put the old key (or the old
# BETTER_AUTH_SECRET) in TOKEN_ENCRYPTION_KEY_PREVIOUS (comma-separated) until the next token save re-encrypts
# the state; without it, a changed key makes the stored tokens unreadable and DealForge refreshes or logs in again.
# TOKEN_ENCRYPTION_KEY=
# TOKEN_ENCRYPTION_KEY_PREVIOUS=
# ATLAS_REFRESH_TOKEN=
# ATLAS_EMAIL=
# ATLAS_PASSWORD=

# Per-tab AI review rubrics: expert guidance and extra checks on four capture tabs
# (opportunity_overview, rationale, financials, funding). Unset = all four ON.
#   AI_RUBRIC_TABS=none                    all four OFF; the review behaves exactly as before the rubrics
#   AI_RUBRIC_TABS=financials,funding      ONLY the listed tabs ON (the list replaces the default)
# The other three tabs (executive_summary, risks, documents) never have a rubric. Switching a
# tab on or off marks that tab's stored AI results stale, so re-run them. See docs/ai-rubric-phase0-audit.md.
# AI_RUBRIC_TABS=

# Email through the SMTP relay Sirius designates (in-region). Without SMTP_HOST,
# email is logged only and never sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DealForge <no-reply@dealforge.local>

# Base URL the server uses to build absolute links to uploaded files.
PUBLIC_BASE_URL=http://localhost:34000

# Broad per-minute ceiling on /api. The integration suite replays many requests
# from a few shared actors, so a local test run raises this above the 600 default.
API_RATE_LIMIT_MAX=600
# Set to 1 to disable every limiter (app + Better Auth sign-in) for local
# integration runs. Never enable in production.
RATE_LIMIT_DISABLED=0
SEED_DEMO_DATA=0
# Seed profile (overrides SEED_DEMO_DATA when set):
#   base = users, organisation tree and configuration only (no opportunities)
#   mvp  = base + the sample pipeline      off = nothing
SEED_PROFILE=

# --- Authentication (Better Auth) --------------------------------------------
# Session secret. REQUIRED in production; generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Default password assigned to seeded app users so they can sign in (change it).
DEFAULT_USER_PASSWORD=DealForge!2026
# Extra browser origins allowed to start a session (comma-separated).
# The public base URL and localhost dev/proxy origins are trusted by default.
AUTH_TRUSTED_ORIGINS=
# Better Auth's own sign-in limiter (independent of API_RATE_LIMIT_MAX).
# Leave blank for the library default (~3 attempts / 10s per IP).
AUTH_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_WINDOW=
# LOCAL TESTING ONLY. Lets the integration test suite act as seeded users via
# x-user-id / x-user-email headers instead of a login session. Set to 1 only
# when running server/tests locally. The server refuses to start in production
# with this enabled. Without a session or this flag, every API call gets 401.
AUTH_ALLOW_HEADER_IDENTITY=0
# Allow the admin console to use header identity too (needs the flag above;
# local tooling only, refused in production).
ADMIN_ALLOW_HEADER_AUTH=0
# Extra browser origins allowed by CORS (comma-separated). PUBLIC_BASE_URL is
# always allowed; localhost dev ports are allowed outside production.
CORS_ALLOWED_ORIGINS=
# Deployment-time feature/menu visibility (comma list of page keys; '-' disables).
FEATURE_FLAGS=

# --- Object storage (ObjectIO / S3-compatible) -------------------------------
# Leave S3_ENDPOINT empty to use the local filesystem (default, no setup).
# ObjectIO exposes a wire-compatible S3 API (default http://localhost:9000);
# MinIO, Cloudflare R2 and AWS S3 use the same settings.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=dealforge
S3_PREFIX=dealforge
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# --- Data room (Coneshare) API integration -----------------------------------
# DealForge integrates the data room as an external service over its REST API.
# Leave empty to disable; DealForge works without a data room.
CONESHARE_BASE_URL=
CONESHARE_API_KEY=
CONESHARE_API_PATH=/api/v1

# --- External web research (AI evidence). Optional; without it no research runs.
# Provider: tavily | brave. The provider must also be approved in Settings > AI Governance.
# Only public identifiers (target name, sector, geography) are ever sent in a query.
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
# RESEARCH_BASE_URL=
# RESEARCH_TIMEOUT_MS=20000

# --- OCR for scanned PDFs and images (tesseract.js, runs on the server).
# Language data downloads on first use; set OCR_LANG_PATH to a local folder of
# *.traineddata files to keep it offline / in-region. e.g. OCR_LANGS=eng+ara
# OCR_LANGS=eng
# OCR_LANG_PATH=
# OCR_MAX_PAGES=15
# EXTRACT_MAX_PAGES=60
# EXTRACT_MAX_BYTES=26214400
